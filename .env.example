# Required
GROQ_API_KEY="" 

# Optional LLM settings
LLM_MODEL=
LLM_MAX_TOKENS=
MAX_HISTORY_TOKENS=

# Optional: local tool
ALPHAVANTAGE_API_KEY=

# Optional: where chat history is stored
DB_PATH=ChatsHistory/chats.db

# Optional: MCP Calculator server (stdio). Leave blank to disable.
UV_COMMAND=uv
CALCULATOR_SERVER_PATH="chatbot\servers_mcp\calculator.py"

